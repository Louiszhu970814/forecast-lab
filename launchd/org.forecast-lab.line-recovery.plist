<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- D140: install after both actual model reviews pass; Louis has authorized activation. This timer uses seconds. -->
<dict>
	<key>Label</key>
	<string>org.forecast-lab.line-recovery</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-i</string>
		<string>/bin/sh</string>
		<string>__PROJECT_ROOT__/launchd/run.sh</string>
		<string>line-recovery</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__PROJECT_ROOT__</string>
	<key>StandardOutPath</key>
	<string>__PROJECT_ROOT__/data/logs/line-recovery.launchd.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__PROJECT_ROOT__/data/logs/line-recovery.launchd.stderr.log</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>RunAtLoad</key>
	<false/>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
