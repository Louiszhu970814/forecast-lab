<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>org.forecast-lab.telegram</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_ROOT__/.venv/bin/python</string>
        <string>-u</string>
        <string>__PROJECT_ROOT__/src/telegram_bot.py</string>
        <string>run</string>
    </array>
    <key>WorkingDirectory</key><string>__PROJECT_ROOT__</string>
    <key>StandardOutPath</key><string>__PROJECT_ROOT__/data/logs/telegram.stdout.log</string>
    <key>StandardErrorPath</key><string>__PROJECT_ROOT__/data/logs/telegram.stderr.log</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>30</integer>
    <key>ProcessType</key><string>Background</string>
</dict>
</plist>
