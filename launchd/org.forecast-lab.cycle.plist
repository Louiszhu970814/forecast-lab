<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Timezone: host must use Asia/Taipei; TZ does not change launchd calendar scheduling. Install only after Louis approves trial. -->
<dict>
	<key>Label</key>
	<string>org.forecast-lab.cycle</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-i</string>
		<string>/bin/sh</string>
		<string>__PROJECT_ROOT__/launchd/run.sh</string>
		<string>cycle</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__PROJECT_ROOT__</string>
	<key>StandardOutPath</key>
	<string>__PROJECT_ROOT__/data/logs/cycle.launchd.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__PROJECT_ROOT__/data/logs/cycle.launchd.stderr.log</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>RunAtLoad</key>
	<false/>
	<key>StartInterval</key>
	<integer>600</integer>
</dict>
</plist>
